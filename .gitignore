################################################## TEMP ##################################################
*.afdesign~lock~
*.afdesign
*.afdesign.meta
/[Aa]ssets/filelist.txt
/[Aa]ssets/filelist.txt.meta
/[Aa]ssets/DoNotReloadDipshit.cs
/[Aa]ssets/DoNotReloadDipshit.cs.meta
[Aa]ssets/_[Pp]roject/_[Ff]eatures/_[Ss]ystems/[Ff]acilityGeneration/[Ee]ditor
/[Aa]ssets/_Project/_Features/_Systems/FacilityGeneration/Editor
/[Aa]ssets/_Project/[Aa]rt/_References/*

################################################## UNITY ##################################################

# Unity plugins (that are utility and/or paid/test-only, so we can ignore)
/[Aa]ssets/[Pp]lugins/[Pp]rivate/*

# Unity auto-generated files
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

## Game settings auto-generated file
/settings.json

# Unity3D auto-generated .meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D auto-generated file on crash reports
sysinfo.txt

# Unity auto-generated files (for the Android platform)
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Unity package files
*.unitypackage
*.unitypackage.meta
*.apk
*.aab
*.app

# Unity MemoryCaptures/Recordings (which can get excessive in size)
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Bank files in the StreamingAssets folder
/[Aa]ssets/[Ss]treamingAssets/**/*.bank
/[Aa]ssets/[Ss]treamingAssets/**/*.bank.meta

# Unity Crashlytics auto-generated file
crashlytics-build.properties

# Unity packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

################################################## FMOD ##################################################

# Never ignore DLLs in the FMOD subfolder
!/[Aa]ssets/Plugins/External/FMOD/**/lib/*

# Don't ignore images and gizmos used by FMOD in the Unity Editor
!/[Aa]ssets/Gizmos/FMOD/*
!/[Aa]ssets/Editor Default Resources/FMOD/*

# Ignore the Cache folder used by FMOD, since it's updated locally
/[Aa]ssets/Plugins/External/FMOD/Cache/*

# Ignore FMOD Studio outputs if it's there
FmodStudio/.cache/
FmodStudio/Build/
FmodStudio/*.user
FmodStudio/*.lock

# As long as the source bank files are kept outside of the StreamingAssets folder, then the log can be ignored
fmod_editor.log

################################################## MISCELLANOUS ##################################################

