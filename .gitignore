################################################## UNITY ##################################################

# Unity plugins (that are utility and paid/test-only, so we can ignore)
/[Aa]ssets/Plugins/Internal/ProductionTools/
/[Aa]ssets/Plugins/Internal/vSeries/

# Unity auto-generated files
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Unity3D auto-generated .meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D auto-generated file on crash reports
sysinfo.txt

# Unity auto-generated files (for the Android platform)
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Unity package files
*.unitypackage
*.unitypackage.meta
*.apk
*.aab
*.app

# Unity MemoryCaptures/Recordings (which can get excessive in size)
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity bank files in the StreamingAssets folder
/[Aa]ssets/StreamingAssets/**/*.bank
/[Aa]ssets/StreamingAssets/**/*.bank.meta

# Unity Crashlytics auto-generated file
crashlytics-build.properties

# Unity packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

################################################## FMOD ##################################################

# Never ignore DLLs in the FMOD subfolder
!/[Aa]ssets/Plugins/FMOD/**/lib/*
!/[Aa]ssets/Plugins/Internal/FMOD/**/lib/*

# Don't ignore images and gizmos used by FMOD in the Unity Editor
!/[Aa]ssets/Gizmos/FMOD/*
!/[Aa]ssets/Editor Default Resources/FMOD/*

# Ignore the Cache folder used by FMOD, since it's updated locally
/[Aa]ssets/Plugins/FMOD/Cache/*
/[Aa]ssets/Plugins/Internal/FMOD/Cache/*

# Ignore FMOD Studio outputs if it's there
FmodStudio/.cache/
FmodStudio/Build/
FmodStudio/*.user
FmodStudio/*.lock

# As long as the source bank files are kept outside of the StreamingAssets folder, then the log can be ignored
fmod_editor.log

################################################## MISCELLANOUS ##################################################

# IDE
.vs/
.vscode/
.vsconfig
.gradle/
.idea/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS-specific files
.DS_Store
