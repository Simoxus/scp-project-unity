  m_TableData:
  - m_Id: 234884767744
    m_Localized: High-level clearance. Opens Keter-class containment areas.
    m_Metadata:
      m_Items: []
  - m_Id: 223224602624
    m_Localized: Senior staff clearance. Opens Euclid-class containment areas.
    m_Metadata:
      m_Items: []
  - m_Id: 205520445440
    m_Localized: Research personnel clearance. Opens basic containment zones.
    m_Metadata:
      m_Items: []
  - m_Id: 12645376000
    m_Localized: Janitor and junior researcher clearance. Opens non-hazardous areas.
    m_Metadata:
      m_Items: []
  - m_Id: 2169088057344
    m_Localized: The identification badge of a Level 2 Researcher.
    m_Metadata:
      m_Items: []
  - m_Id: 2139811815424
    m_Localized: A delicate paper crane..
    m_Metadata:
      m_Items: []
  - m_Id: 2110053228544
    m_Localized: A single card from a standard deck. Entirely useless.
    m_Metadata:
      m_Items: []
  - m_Id: 2092898525184
    m_Localized: A commercial credit card. Entirely useless.
    m_Metadata:
      m_Items: []
  - m_Id: 2048623452160
    m_Localized: A container holding a liquid of unknown origin. It smells faintly
      of ozone and citrus.
    m_Metadata:
      m_Items: []
  - m_Id: 1941584814080
    m_Localized: A particularly pungent sample of 420-J.
    m_Metadata:
      m_Items: []
  - m_Id: 2003605987328
    m_Localized: '[REDACTED]. Highly potent, non-standard "medical" herb.'
    m_Metadata:
      m_Items: []
  - m_Id: 1909380947968
    m_Localized: Experimental optical unit. Allows the wearer to filter or perceive
      certain cognitohazards.
    m_Metadata:
      m_Items: []
  - m_Id: 1886698151936
    m_Localized: An advanced optic enhancer with optimized power efficiency. Provides
      superior clarity.
    m_Metadata:
      m_Items: []
  - m_Id: 1841416445952
    m_Localized: Standard-issue optical enhancer for low-light operations. Improves
      visibility in total darkness at the cost of high power consumption.
    m_Metadata:
      m_Items: []
  - m_Id: 1816716189696
    m_Localized: Personal item belonging to a Site employee. May contain quarters.
    m_Metadata:
      m_Items: []
  - m_Id: 1796239597568
    m_Localized: A standard clipboard used for holding paperwork. Also occasionally
      useful as a rudimentary shield.
    m_Metadata:
      m_Items: []
  - m_Id: 1752669167616
    m_Localized: Biological remains of a Foundation staff member. Useful for bypassing
      DNA scanners.
    m_Metadata:
      m_Items: []
  - m_Id: 1620498259968
    m_Localized: A pill resembling SCP-500.
    m_Metadata:
      m_Items: []
  - m_Id: 1477082423296
    m_Localized: A single instance of SCP-500. Capable of curing all known physical
      ailments within minutes. Use only in dire emergencies.
    m_Metadata:
      m_Items: []
  - m_Id: 1587623305216
    m_Localized: A generic pharmaceutical. Effect unknown.
    m_Metadata:
      m_Items: []
  - m_Id: 1380814757888
    m_Localized: An anomalous chemical solution. While use of the solution eliminates
      the need to blink for extended periods, users report a disturbing, permanent
      tint to their vision.
    m_Metadata:
      m_Items: []
  - m_Id: 1351593041920
    m_Localized: Lubricant intended for personnel assigned to long-term surveillance
      duties.
    m_Metadata:
      m_Items: []
  - m_Id: 1330399223808
    m_Localized: A peculiar looking alkaline battery that appears to emit a faint
      glow.
    m_Metadata:
      m_Items: []
  - m_Id: 1319410147328
    m_Localized: A high-capacity 18-volt power cell. Designed for extended use in
      heavy-duty equipment.
    m_Metadata:
      m_Items: []
  - m_Id: 1275525144576
    m_Localized: A standard 9-volt alkaline battery used to power various handheld
      electronic devices.
    m_Metadata:
      m_Items: []
  - m_Id: 1244634095616
    m_Localized: A standard Foundation two-way radio transceiver for internal communication.
    m_Metadata:
      m_Items: []
  - m_Id: 1230310547456
    m_Localized: A specialized, lightweight protective suit. Offers high mobility
      without compromising shielding.
    m_Metadata:
      m_Items: []
  - m_Id: 1214837760000
    m_Localized: Heavily reinforced hazardous environment suit. Lining is treated
      to mitigate memetic effects.
    m_Metadata:
      m_Items: []
  - m_Id: 1192620531712
    m_Localized: Level A CBRN protection suit. Essential for surviving prolonged
      exposure to biohazards.
    m_Metadata:
      m_Items: []
  - m_Id: 1113801170944
    m_Localized: A handheld navigation system. Used extensively in the Modular Site.
    m_Metadata:
      m_Items: []
  - m_Id: 1088014589952
    m_Localized: Standard security-grade tactical armor. Effective against small
      arms fire, though the weight inhibits movement greatly.
    m_Metadata:
      m_Items: []
  - m_Id: 1069064724480
    m_Localized: An emergency medical injector. Provides an immediate surge in endurance
      but risks causing extreme vascular damage.
    m_Metadata:
      m_Items: []
  - m_Id: 1049032728576
    m_Localized: An experimental medical kit produced using SCP-914.
    m_Metadata:
      m_Items: []
  - m_Id: 1021593591808
    m_Localized: A compact emergency medical kit. Designed for rapid administration.
    m_Metadata:
      m_Items: []
  - m_Id: 944544227328
    m_Localized: Foundation-issue medical kit. Contains essential supplies for stabilizing
      trauma and internal hemorrhaging.
    m_Metadata:
      m_Items: []
  - m_Id: 808988516352
    m_Localized: Reinforced tactical gas mask. Offers moderate protection against
      certain memetic effects.
    m_Metadata:
      m_Items: []
  - m_Id: 794044211200
    m_Localized: A modified respiratory unit. Filter additives appear to provide
      an unexpected boost to the wearer's stamina and endurance.
    m_Metadata:
      m_Items: []
  - m_Id: 737395941376
    m_Localized: Standard-issue respiratory protection. Designed to filter out facility
      decontamination gases.
    m_Metadata:
      m_Items: []
  - m_Id: 439608745984
    m_Localized: A standard United States issued twenty-five-cent coin.
    m_Metadata:
      m_Items: []
  - m_Id: 265943644708864
    m_Localized: '[REDACTED].'
    m_Metadata:
      m_Items: []
  - m_Id: 236424077312
    m_Localized: Maximum clearance. Opens nearly all of the facility.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
