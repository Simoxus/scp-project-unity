%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tooltip_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 5d945128acb377b428b4c60aea5aaa39, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 7758795055104
    m_Localized: "Seleccione el motor de renderizado.\n<color=#f7a000>Esta configuraci\xF3n
      solo se puede cambiar desde la l\xEDnea de comandos.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 8764547211264
    m_Localized: "Muestra la ret\xEDcula de apuntado en el centro de la pantalla."
    m_Metadata:
      m_Items: []
  - m_Id: 7852336422912
    m_Localized: "Elige entre modo Pantalla completa, Ventana o Sin bordes.\\nSin
      bordes permite cambiar r\xE1pidamente entre aplicaciones, manteniendo la apariencia
      de pantalla completa."
    m_Metadata:
      m_Items: []
  - m_Id: 7867750490112
    m_Localized: "Establece la resoluci\xF3n de la ventana o pantalla.\\nResoluciones
      m\xE1s altas ofrecen mayor nitidez de imagen, pero reducen el rendimiento."
    m_Metadata:
      m_Items: []
  - m_Id: 7894245908480
    m_Localized: "Ajusta la resoluci\xF3n de renderizado como porcentaje de la resoluci\xF3n
      de ventana.\\nValores m\xE1s bajos mejoran el rendimiento, mientras que valores
      m\xE1s altos aumentan la calidad."
    m_Metadata:
      m_Items: []
  - m_Id: 7915599110144
    m_Localized: "Sincroniza la tasa de fotogramas con la frecuencia de actualizaci\xF3n
      del monitor para eliminar el desgarro de pantalla.\\nPuede introducir retraso
      de entrada."
    m_Metadata:
      m_Items: []
  - m_Id: 7964752158720
    m_Localized: "Limita la tasa m\xE1xima de fotogramas.\\nIlimitado permite el
      m\xE1ximo rendimiento, pero tambi\xE9n puedes establecer un l\xEDmite espec\xEDfico
      para reducir el consumo de energ\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 8022906183680
    m_Localized: "Controla la resoluci\xF3n y detalle de las texturas.\\nMayor calidad
      usa m\xE1s VRAM, pero proporciona im\xE1genes m\xE1s n\xEDtidas."
    m_Metadata:
      m_Items: []
  - m_Id: 8047426084864
    m_Localized: "Suaviza los bordes irregulares de los objetos.\\nConfiguraci\xF3n
      m\xE1s alta mejora la calidad visual pero afecta el rendimiento."
    m_Metadata:
      m_Items: []
  - m_Id: 8063519629312
    m_Localized: Activa o desactiva el renderizado de sombras en tiempo real.\nLas
      sombras mejoran la profundidad visual y el realismo, pero son intensivas en
      rendimiento.
    m_Metadata:
      m_Items: []
  - m_Id: 8081383170048
    m_Localized: "A\xF1ade un efecto de \"resplandor\" a las fuentes de luz brillantes.\\nCrea
      una apariencia m\xE1s cinematogr\xE1fica, pero tiene un ligero coste de rendimiento
      y puede ocultar detalles en \xE1reas brillantes."
    m_Metadata:
      m_Items: []
  - m_Id: 8126719401984
    m_Localized: "Oscurece los bordes de la pantalla.\\nCrea una apariencia m\xE1s
      cinematogr\xE1fica."
    m_Metadata:
      m_Items: []
  - m_Id: 8138694139904
    m_Localized: Controla el nivel de volumen general para todo el audio del juego.
    m_Metadata:
      m_Items: []
  - m_Id: 8157530759168
    m_Localized: Controla el volumen de los efectos de sonido, como pasos, disparos
      y sonidos ambientales.
    m_Metadata:
      m_Items: []
  - m_Id: 8180117086208
    m_Localized: "Controla el volumen de la m\xFAsica de fondo y las bandas sonoras."
    m_Metadata:
      m_Items: []
  - m_Id: 8205719117824
    m_Localized: "Ajusta el volumen de los di\xE1logos de personajes y actuaci\xF3n
      de voz."
    m_Metadata:
      m_Items: []
  - m_Id: 8234013892608
    m_Localized: "Controla el volumen de los sonidos del men\xFA, clics de botones
      y retroalimentaci\xF3n de la interfaz."
    m_Metadata:
      m_Items: []
  - m_Id: 8264561008640
    m_Localized: "Amortigua sonidos seg\xFAn las paredes y obst\xE1culos entre t\xFA
      y la fuente de sonido.\\nA\xF1ade realismo pero usa m\xE1s CPU."
    m_Metadata:
      m_Items: []
  - m_Id: 8343233568768
    m_Localized: "Muestra subt\xEDtulos de texto para di\xE1logos y sonidos importantes."
    m_Metadata:
      m_Items: []
  - m_Id: 8378377641984
    m_Localized: "Muestra nombres en los subt\xEDtulos para identificar qui\xE9n
      est\xE1 hablando."
    m_Metadata:
      m_Items: []
  - m_Id: 8402029322240
    m_Localized: "Invierte el movimiento vertical de la c\xE1mara.\\nMirar hacia
      arriba te hace mirar hacia abajo, mientras que mirar hacia abajo te hace mirar
      hacia arriba."
    m_Metadata:
      m_Items: []
  - m_Id: 8425253183488
    m_Localized: "Ajusta qu\xE9 tan r\xE1pido gira la c\xE1mara al mover el rat\xF3n.\\nValores
      m\xE1s altos significan giros m\xE1s r\xE1pidos."
    m_Metadata:
      m_Items: []
  - m_Id: 8444576342016
    m_Localized: "A\xF1ade suavidad a los movimientos de la c\xE1mara.\\nValores
      m\xE1s altos crean movimiento m\xE1s fluido pero se sentir\xE1 menos receptivo."
    m_Metadata:
      m_Items: []
  - m_Id: 8467355607040
    m_Localized: "Ajusta qu\xE9 tan r\xE1pido gira la c\xE1mara con la entrada del
      stick del mando.\\nValores m\xE1s altos significan giros m\xE1s r\xE1pidos."
    m_Metadata:
      m_Items: []
  - m_Id: 8503279820800
    m_Localized: "A\xF1ade suavidad a los movimientos de c\xE1mara con mando.\\nReduce
      el movimiento tembloroso, pero puede sentirse menos preciso."
    m_Metadata:
      m_Items: []
  - m_Id: 8526423990272
    m_Localized: "Activa la retroalimentaci\xF3n por vibraci\xF3n en mandos compatibles
      durante eventos de juego."
    m_Metadata:
      m_Items: []
  - m_Id: 8549580742656
    m_Localized: "Establece la f\xF3rmula de balanceo que simula un movimiento de
      caminata."
    m_Metadata:
      m_Items: []
  - m_Id: 8653834362880
    m_Localized: "Selecciona el idioma para el texto del juego, men\xFAs y subt\xEDtulos.\\nPuede
      requerir reinicio."
    m_Metadata:
      m_Items: []
  - m_Id: 8679880990720
    m_Localized: "Mostrar la pantalla de visualizaci\xF3n frontal."
    m_Metadata:
      m_Items: []
  - m_Id: 8696507211776
    m_Localized: Muestra la tasa de fotogramas actual en la esquina de la pantalla.
    m_Metadata:
      m_Items: []
  - m_Id: 8796046434304
    m_Localized: "A\xF1ade efectos animados a los contornos y resaltados de objetos.\\nDesactivar
      puede mejorar ligeramente el rendimiento."
    m_Metadata:
      m_Items: []
  - m_Id: 8818133639168
    m_Localized: Muestra ventanas emergentes cuando se desbloquean logros.
    m_Metadata:
      m_Items: []
  - m_Id: 8851822288896
    m_Localized: "Activa la consola de desarrollador para comandos y depuraci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 8877143302144
    m_Localized: "Abre autom\xE1ticamente la consola de desarrollador cuando ocurre
      un error.\\n\xDAtil para solucionar problemas."
    m_Metadata:
      m_Items: []
  - m_Id: 11938918113280
    m_Localized: "Activar telemetr\xEDa de fondo detallada.\\nEsto afectar\xE1 significativamente
      al rendimiento."
    m_Metadata:
      m_Items: []
  - m_Id: 6115690649559040
    m_Localized: "Ajusta la extensi\xF3n del mundo visible en pantalla. Los valores
      m\xE1s altos proporcionan una visi\xF3n perif\xE9rica m\xE1s amplia, pero provocan
      un efecto de \"ojo de pez\" y pueden afectar negativamente la inmersi\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 9455871192539136
    m_Localized: "Simula sombras en las esquinas donde se encuentran los objetos.\\nEsto
      afectar\xE1 ligeramente el rendimiento."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
