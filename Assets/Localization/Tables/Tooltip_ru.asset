  - m_Id: 6115690649559040
    m_Localized: "\u041E\u0442\u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0439\u0442\u0435
      \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u0438\u0433\u0440\u043E\u0432\u043E\u0433\u043E
      \u043C\u0438\u0440\u0430, \u0432\u0438\u0434\u0438\u043C\u0443\u044E \u043D\u0430
      \u044D\u043A\u0440\u0430\u043D\u0435. \u0412\u044B\u0441\u043E\u043A\u0438\u0435
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u044E\u0442
      \u043F\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0439\u043D\u044B\u0439 \u043E\u0431\u0437\u043E\u0440,
      \u043D\u043E \u0432\u044B\u0437\u044B\u0432\u0430\u044E\u0442 \u044D\u0444\u0444\u0435\u043A\u0442
      \xAB\u0440\u044B\u0431\u044C\u0435\u0433\u043E \u0433\u043B\u0430\u0437\u0430\xBB,
      \u0447\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u043E\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u044D\u0444\u0444\u0435\u043A\u0442\u0435
      \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 9455871192539136
