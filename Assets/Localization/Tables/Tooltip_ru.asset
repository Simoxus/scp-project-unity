  m_TableData:
  - m_Id: 7758795055104
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0439
      \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u0440\u0435\u043D\u0434\u0435\u0440\u0438\u043D\u0433\u0430.\n<color=#f7a000>\u042D\u0442\u043E\u0442
      \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440 \u043C\u043E\u0436\u043D\u043E
      \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u0439
      \u0441\u0442\u0440\u043E\u043A\u0438.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 7852336422912
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0440\u0435\u0436\u0438\u043C:
      \u041F\u043E\u043B\u043D\u043E\u044D\u043A\u0440\u0430\u043D\u043D\u044B\u0439,
      \u041E\u043A\u043E\u043D\u043D\u044B\u0439 \u0438\u043B\u0438 \u0411\u0435\u0437
      \u0440\u0430\u043C\u043A\u0438.\\n\u0420\u0435\u0436\u0438\u043C \u0431\u0435\u0437
      \u0440\u0430\u043C\u043A\u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u044C\u0441\u044F
      \u043C\u0435\u0436\u0434\u0443 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F\u043C\u0438,
      \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044F \u0432\u043D\u0435\u0448\u043D\u0438\u0439
      \u0432\u0438\u0434 \u043F\u043E\u043B\u043D\u043E\u0433\u043E \u044D\u043A\u0440\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7867750490112
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u043E\u043A\u043D\u0430 \u0438\u043B\u0438 \u044D\u043A\u0440\u0430\u043D\u0430.\\n\u0411\u043E\u043B\u0435\u0435
      \u0432\u044B\u0441\u043E\u043A\u0438\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u0431\u043E\u043B\u0435\u0435
      \u0447\u0451\u0442\u043A\u043E\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435,
      \u043D\u043E \u0441\u043D\u0438\u0436\u0430\u044E\u0442 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 7894245908480
    m_Localized: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0440\u0435\u043D\u0434\u0435\u0440\u0438\u043D\u0433\u0430 \u0432 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u0430\u0445
      \u043E\u0442 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F \u043E\u043A\u043D\u0430.\\n\u0411\u043E\u043B\u0435\u0435
      \u043D\u0438\u0437\u043A\u0438\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F
      \u043F\u043E\u0432\u044B\u0448\u0430\u044E\u0442 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
      \u0431\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u0438\u0435 \u0443\u043B\u0443\u0447\u0448\u0430\u044E\u0442
      \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 7915599110144
    m_Localized: "\u0421\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0438\u0440\u0443\u0439\u0442\u0435
      \u0447\u0430\u0441\u0442\u043E\u0442\u0443 \u043A\u0430\u0434\u0440\u043E\u0432
      \u0441 \u0447\u0430\u0441\u0442\u043E\u0442\u043E\u0439 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u0430 \u0434\u043B\u044F \u0443\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u044F
      \u0440\u0430\u0437\u0440\u044B\u0432\u043E\u0432 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F.\\n\u041C\u043E\u0436\u0435\u0442
      \u0432\u044B\u0437\u0432\u0430\u0442\u044C \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0443
      \u0432\u0432\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7964752158720
    m_Localized: "\u041E\u0433\u0440\u0430\u043D\u0438\u0447\u044C\u0442\u0435 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0443\u044E
      \u0447\u0430\u0441\u0442\u043E\u0442\u0443 \u043A\u0430\u0434\u0440\u043E\u0432.\\n\u041D\u0435\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0439
      \u0440\u0435\u0436\u0438\u043C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
      \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0443\u044E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
      \u043D\u043E \u0432\u044B \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439
      \u043B\u0438\u043C\u0438\u0442 \u0434\u043B\u044F \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044F
      \u044D\u043D\u0435\u0440\u0433\u043E\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 8022906183680
    m_Localized: "\u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C
      \u0438 \u0434\u0435\u0442\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0435\u0439
      \u0442\u0435\u043A\u0441\u0442\u0443\u0440.\\n\u0411\u043E\u043B\u0435\u0435
      \u0432\u044B\u0441\u043E\u043A\u043E\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0438\u0434\u0435\u043E\u043F\u0430\u043C\u044F\u0442\u0438, \u043D\u043E
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0431\u043E\u043B\u0435\u0435
      \u0447\u0451\u0442\u043A\u0443\u044E \u0433\u0440\u0430\u0444\u0438\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 8047426084864
    m_Localized: "\u0421\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      \u043D\u0435\u0440\u043E\u0432\u043D\u044B\u0435 \u043A\u0440\u0430\u044F \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432.\\n\u0411\u043E\u043B\u0435\u0435
      \u0432\u044B\u0441\u043E\u043A\u0438\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
      \u0443\u043B\u0443\u0447\u0448\u0430\u044E\u0442 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E\u0435
      \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E, \u043D\u043E \u0432\u043B\u0438\u044F\u044E\u0442
      \u043D\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C.\u0435\u043D\u0438\u044F
      \u043C\u0435\u0440\u0446\u0430\u043D\u0438\u044F, \u043D\u043E \u043C\u043E\u0436\u0435\u0442
      \u0432\u044B\u0437\u044B\u0432\u0430\u0442\u044C \u044D\u0444\u0444\u0435\u043A\u0442
      \u043E\u0440\u0435\u043E\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 8063519629312
    m_Localized: "\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0438\u043B\u0438
      \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0440\u0435\u043D\u0434\u0435\u0440\u0438\u043D\u0433
      \u0442\u0435\u043D\u0435\u0439 \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u043C
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438.\\n\u0422\u0435\u043D\u0438 \u0443\u043B\u0443\u0447\u0448\u0430\u044E\u0442
      \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u0443\u044E \u0433\u043B\u0443\u0431\u0438\u043D\u0443
      \u0438 \u0440\u0435\u0430\u043B\u0438\u0437\u043C, \u043D\u043E \u0442\u0440\u0435\u0431\u0443\u044E\u0442
      \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 8081383170048
    m_Localized: "\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u044D\u0444\u0444\u0435\u043A\u0442
      \"\u0441\u0432\u0435\u0447\u0435\u043D\u0438\u044F\" \u043A \u044F\u0440\u043A\u0438\u043C
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430\u043C \u0441\u0432\u0435\u0442\u0430.\\n\u0421\u043E\u0437\u0434\u0430\u0451\u0442
      \u0431\u043E\u043B\u0435\u0435 \u043A\u0438\u043D\u0435\u043C\u0430\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u043D\u044B\u0439
      \u0432\u0438\u0434, \u043D\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0438 \u043C\u043E\u0436\u0435\u0442 \u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C
      \u0434\u0435\u0442\u0430\u043B\u0438 \u0432 \u044F\u0440\u043A\u0438\u0445
      \u043E\u0431\u043B\u0430\u0441\u0442\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 8126719401984
    m_Localized: "\u0417\u0430\u0442\u0435\u043C\u043D\u044F\u0435\u0442 \u043A\u0440\u0430\u044F
      \u044D\u043A\u0440\u0430\u043D\u0430.\\n\u0421\u043E\u0437\u0434\u0430\u0451\u0442
      \u0431\u043E\u043B\u0435\u0435 \u043A\u0438\u043D\u0435\u043C\u0430\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u043D\u044B\u0439
      \u0432\u0438\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 8138694139904
    m_Localized: "\u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u043E\u0431\u0449\u0438\u043C
      \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u0438
      \u0432\u0441\u0435\u0433\u043E \u0437\u0432\u0443\u043A\u0430 \u0432 \u0438\u0433\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 8157530759168
    m_Localized: "\u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C\u044E
      \u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0445 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432,
      \u0442\u0430\u043A\u0438\u0445 \u043A\u0430\u043A \u0448\u0430\u0433\u0438,
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u0438 \u0437\u0432\u0443\u043A\u0438
      \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 8180117086208
    m_Localized: "\u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C\u044E
